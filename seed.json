  "genome": "1",
  "name": "kar-benfordgap",
  "kind": "tool",
  "purpose": "A first-digit fraud screen for a column of amounts: compares how often each first digit appears with Benford's Law and gives one verdict, with chi-square, Nigrini's MAD and the digits to look at first, with no AI judge.",
  "lane": {
    "id": "benford-screen",
    "accepts": "a column of amounts (numbers or ledger strings such as £1,200.00 or (350.50)) with at least one usable nonzero amount, and optionally the sample floor",
    "refuses": "anything that is not a list of amounts, such as a CSV pasted as one string, a list with no usable amount, or a question about whether someone committed fraud"
  },
  "interface": {
    "in": "{\"values\":[<amount>,...],\"minN\":<optional floor>,\"verdict\":\"<claimed verdict>\"}",
    "out": "one verdict (too-few, close, acceptable, marginal or nonconformity) and which test gave it, with the counts, chi-square, MAD and z per digit"
  },
